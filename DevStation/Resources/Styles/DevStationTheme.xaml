        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- Reject button (red tint) -->
    <Style x:Key="RejectButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StatusErrorMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StatusError}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource StatusError}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- Кликабельная карточка инструментов с hover-эффектом -->
    <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource CardNoPadding}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Аватар пользователя (круг с инициалами) -->
    <Style x:Key="UserAvatar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

</ResourceDictionary>
