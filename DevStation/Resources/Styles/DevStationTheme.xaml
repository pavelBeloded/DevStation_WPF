    <Style x:Key="StatusCompleted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusActive}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Статус QUEUED (серый uppercase) -->
