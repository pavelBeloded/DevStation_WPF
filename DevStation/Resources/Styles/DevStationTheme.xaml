<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- 1. COLORS                                                     -->
    <!-- ============================================================ -->

    <!-- Backgrounds -->
    <Color x:Key="AppBackgroundColor">#121212</Color>
    <Color x:Key="SidebarBackgroundColor">#181818</Color>
    <Color x:Key="CardBackgroundColor">#181818</Color>
    <Color x:Key="HeaderBackgroundColor">#121212</Color>
    <Color x:Key="InputBackgroundColor">#181818</Color>
    <Color x:Key="DropZoneBackgroundColor">#181818</Color>
    <Color x:Key="CodeBackgroundColor">#0C0C0C</Color>
    <Color x:Key="TableRowHoverColor">#1F1F1F</Color>

    <!-- Accent -->
    <Color x:Key="AccentPrimaryColor">#FFB86C</Color>
    <Color x:Key="AccentHoverColor">#E8961A</Color>
    <Color x:Key="AccentMutedColor">#1AF5A623</Color>
    <Color x:Key="AccentSelectionColor">#50FFB86C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#6B6B6B</Color>
    <Color x:Key="TextMutedColor">#4A4A4A</Color>
    <Color x:Key="TextAccentColor">#FFB86C</Color>
    <Color x:Key="TextLabelColor">#9A9A9A</Color>
    <Color x:Key="TextBodyColor">#B0B0B0</Color>
    <Color x:Key="TextCodeColor">#E8E8E8</Color>
    <Color x:Key="TextCodeKeywordColor">#FFB86C</Color>
    <Color x:Key="TextCodeStringColor">#CE9178</Color>
    <Color x:Key="TextCodeCommentColor">#6A9955</Color>

    <!-- Borders -->
    <Color x:Key="BorderDefaultColor">#2A2A2A</Color>
    <Color x:Key="BorderSubtleColor">#222222</Color>
    <Color x:Key="BorderAccentColor">#FFB86C</Color>
    <Color x:Key="BorderDashedColor">#3A3A3A</Color>
    <Color x:Key="BorderInputColor">#2E2E2E</Color>

    <!-- Status -->
    <Color x:Key="StatusActiveColor">#FFB86C</Color>
    <Color x:Key="StatusQueuedColor">#4A4A4A</Color>
    <Color x:Key="StatusReadyColor">#22C55E</Color>

    <!-- ============================================================ -->
    <!-- 2. BRUSHES                                                    -->
    <!-- ============================================================ -->

    <SolidColorBrush x:Key="AppBackground"       Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackground"   Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackground"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderBackground"    Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackground"     Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="DropZoneBackground"  Color="{StaticResource DropZoneBackgroundColor}"/>
    <SolidColorBrush x:Key="CodeBackground"      Color="{StaticResource CodeBackgroundColor}"/>

    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"    Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush"      Color="{StaticResource AccentMutedColor}"/>
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="{StaticResource AccentSelectionColor}"/>

    <SolidColorBrush x:Key="TextPrimary"         Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"       Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"           Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextAccent"          Color="{StaticResource TextAccentColor}"/>
    <SolidColorBrush x:Key="TextLabel"           Color="{StaticResource TextLabelColor}"/>
    <SolidColorBrush x:Key="TextBody"            Color="{StaticResource TextBodyColor}"/>
    <SolidColorBrush x:Key="TextCode"            Color="{StaticResource TextCodeColor}"/>
    <SolidColorBrush x:Key="TextCodeKeyword"    Color="{StaticResource TextCodeKeywordColor}"/>
    <SolidColorBrush x:Key="TextCodeString"     Color="{StaticResource TextCodeStringColor}"/>
    <SolidColorBrush x:Key="TextCodeComment"    Color="{StaticResource TextCodeCommentColor}"/>

    <SolidColorBrush x:Key="BorderDefault"       Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush x:Key="BorderSubtle"        Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderAccent"        Color="{StaticResource BorderAccentColor}"/>
    <SolidColorBrush x:Key="BorderInput"         Color="{StaticResource BorderInputColor}"/>

    <SolidColorBrush x:Key="StatusActive"        Color="{StaticResource StatusActiveColor}"/>
    <SolidColorBrush x:Key="StatusQueued"        Color="{StaticResource StatusQueuedColor}"/>
    <SolidColorBrush x:Key="StatusReady"         Color="{StaticResource StatusReadyColor}"/>
    <SolidColorBrush x:Key="Transparent"         Color="Transparent"/>

    <!-- ============================================================ -->
    <!-- 3. TYPOGRAPHY STYLES                                          -->
    <!-- ============================================================ -->

    <!-- Заголовок страницы: "Image Optimizer", "Mock Data Generator" -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Подзаголовок страницы: "Lightning-fast compression..." -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Заголовок секции: "Quick Access", "Configuration" -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Заголовок карточки: "Auth Hooks", "Bento Layouts" -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- Маленький заголовок карточки: "Workspace Manager" -->
    <Style x:Key="CardTitleSmall" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Описание карточки -->
    <Style x:Key="CardBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <!-- ID метка: "ID: 4492" -->
    <Style x:Key="CardId" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- Лейбл поля: "ENTITY NAME", "GENERATION COUNT" -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Заголовок таблицы: "FILENAME", "ORIGINAL SIZE" -->
    <Style x:Key="TableHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Текст в коде/монospace -->
    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="{StaticResource TextCode}"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <!-- ============================================================ -->
    <!-- 4. BUTTON STYLES                                              -->
    <!-- ============================================================ -->

    <!-- Шаблон для кастомных кнопок -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Основная оранжевая кнопка: CHECK, Download, Generate -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#0E0E0E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- Outlined кнопка: Filter, New Snippet, Copy, Delete all -->
    <Style x:Key="OutlinedButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- INSTALL кнопка на карточках сниппетов -->
    <Style x:Key="InstallButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- Ghost кнопка: Copy to clipboard, иконки-действия -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>

    <!-- Кнопка CHECK (полная ширина карточки) -->
    <Style x:Key="CheckButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <!-- ============================================================ -->
    <!-- 5. INPUT STYLES                                               -->
    <!-- ============================================================ -->

    <!-- Шаблон TextBox -->
    <ControlTemplate x:Key="FlatTextBoxTemplate" TargetType="TextBox">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Основное поле ввода -->
    <Style x:Key="DefaultInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template" Value="{StaticResource FlatTextBoxTemplate}"/>
    </Style>

    <!-- Поле поиска (TopBar) -->
    <Style x:Key="SearchInput" TargetType="TextBox" BasedOn="{StaticResource DefaultInput}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
    </Style>

    <!-- Многострочное поле (для кода) -->
    <Style x:Key="CodeInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CodeBackground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextCode}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- Тёмный ComboBox (Mock Generator — выбор типа поля) -->
    <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>
                    <Path Grid.Column="1" x:Name="Arrow"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextMuted}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <!-- Прозрачная кнопка-переключатель открытия попапа -->
            <ToggleButton Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press"
                          Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <!-- Выпадающий список -->
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
                <Border Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,2,0,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                        SnapsToDevicePixels="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background"      Value="{StaticResource InputBackground}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderInput}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template"        Value="{StaticResource DarkComboBoxTemplate}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="FontSize"    Value="12"/>
                    <Setter Property="FontFamily"  Value="Segoe UI"/>
                    <Setter Property="Padding"     Value="10,7"/>
                    <Setter Property="Cursor"      Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1F1F1F"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentMutedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- 6. CARD STYLES                                                -->
    <!-- ============================================================ -->

    <!-- Основная карточка -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <!-- Карточка без padding (для таблиц, кода) -->
    <Style x:Key="CardNoPadding" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Drop Zone (пунктирная оранжевая граница) -->
    <Style x:Key="DropZone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DropZoneBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="40"/>
        <!-- Пунктирную границу в WPF делаем через Style.Triggers или через Rectangle.StrokeDashArray -->
    </Style>

    <!-- Карточка сниппета (Cloud Snippets) -->
    <Style x:Key="SnippetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Карточка Quick Access -->
    <Style x:Key="QuickAccessCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Иконка Quick Access (оранжевый квадрат) -->
    <Style x:Key="QuickAccessIcon" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- ============================================================ -->
    <!-- 7. SIDEBAR STYLES                                             -->
    <!-- ============================================================ -->

    <!-- Контейнер боковой панели -->
    <Style x:Key="SidebarContainer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Width" Value="232"/>
    </Style>

    <!-- Шаблон пункта меню с оранжевой полосой слева при активном состоянии -->
    <ControlTemplate x:Key="SidebarItemTemplate" TargetType="Button">
        <Grid Height="{TemplateBinding Height}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Оранжевая полоса слева (видима только при Tag="active") -->
            <Rectangle x:Name="AccentLine"
                       Grid.Column="0"
                       Fill="{StaticResource AccentBrush}"
                       RadiusX="1.5" RadiusY="1.5"
                       Visibility="Collapsed"
                       Margin="0,8"/>

            <!-- Фон и контент пункта меню -->
            <Border x:Name="ItemBg"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Margin="4,2,8,2"
                    Padding="10,0">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="#1F1F1F"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="#252525"/>
            </Trigger>
            <!-- Tag="active" имеет приоритет над IsMouseOver (определён последним) -->
            <Trigger Property="Tag" Value="active">
                <Setter TargetName="AccentLine" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ItemBg" Property="Background" Value="{StaticResource AccentMutedBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Неактивный пункт меню -->
    <Style x:Key="SidebarItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template" Value="{StaticResource SidebarItemTemplate}"/>
    </Style>

    <!-- Активный пункт меню — оранжевый accent -->
    <Style x:Key="SidebarItemActive" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <!-- Левую оранжевую полосу добавить через отдельный Rectangle в шаблоне -->
    </Style>

    <!-- Текст активного пункта меню -->
    <Style x:Key="SidebarItemTextActive" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Текст неактивного пункта меню -->
    <Style x:Key="SidebarItemText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Логотип DevStation -->
    <Style x:Key="LogoText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
