<UserControl x:Class="DevStation.Views.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevStation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountViewModel}"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40">

            <!-- ── Header ──────────────────────────────────────── -->
            <TextBlock Text="Account" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage your profile and security settings"
                       Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROFILE" Style="{StaticResource TableHeader}"
                                       Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{StaticResource AccentMutedBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1.5">
                                    <TextBlock Text="{Binding Initials}"
                                               FontSize="20" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="17" FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Role + Member Since -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ROLE" Style="{StaticResource TableHeader}"
                                               Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource AccentMutedBrush}"
                                            CornerRadius="4" Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="MEMBER SINCE" Style="{StaticResource TableHeader}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding MemberSince}"
                                               FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextLabel}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="ACTIVITY" Style="{StaticResource TableHeader}"/>
                                <TextBlock Text="  Loading…"
                                           FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsLoading,
                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <UniformGrid Columns="2" Rows="2">
                                <Border Background="{StaticResource CodeBackground}"
                                        CornerRadius="6" Padding="16,12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Stats.TotalSnippets}"
                                                   FontSize="28" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Total Snippets"
                                                   FontSize="11" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CodeBackground}"
                                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Stats.InstalledSnippets}"
                                                   FontSize="28" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="In Library"
                                                   FontSize="11" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CodeBackground}"
                                        CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Stats.PublishedSnippets}"
                                                   FontSize="28" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource StatusReady}"/>
                                        <TextBlock Text="Published"
                                                   FontSize="11" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CodeBackground}"
                                        CornerRadius="6" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Stats.PendingSnippets}"
                                                   FontSize="28" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource StatusActive}"/>
                                        <TextBlock Text="Pending Review"
                                                   FontSize="11" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CHANGE USERNAME" Style="{StaticResource TableHeader}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="NEW USERNAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DefaultInput}"
                                     Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding UsernameError}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource StatusError}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasUsernameError,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Username updated successfully!"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource StatusReady}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding UsernameSuccess,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button Content="Save Username"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding UpdateUsernameCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Change Password Card -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource TableHeader}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="currentPasswordBox"
                                         Style="{StaticResource DefaultPasswordBox}"
                                         PasswordChanged="CurrentPasswordBox_PasswordChanged"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="newPasswordBox"
                                         Style="{StaticResource DefaultPasswordBox}"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="confirmPasswordBox"
                                         Style="{StaticResource DefaultPasswordBox}"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding PasswordError}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource StatusError}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasPasswordError,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Password updated successfully!"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource StatusReady}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding PasswordSuccess,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button Content="Save Password"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding UpdatePasswordCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <Border Margin="0,24,0,0"
                    Visibility="{Binding IsAdmin,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="User Management"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Promote or demote users. You cannot change your own role."
                                       Style="{StaticResource PageSubtitle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{StaticResource AccentMutedBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4" Padding="10,4">
                            <TextBlock Text="ADMIN ONLY" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardNoPadding}">
                        <StackPanel>

                            <Border Padding="16,12"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1">
                                <TextBox Style="{StaticResource DefaultInput}"
                                         Height="36"
                                         Text="{Binding UserSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <!-- Success message -->
                            <Border Padding="16,10"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Visibility="{Binding AdminActionSuccess,
                                                 Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding AdminActionSuccess}"
                                           FontSize="13" FontFamily="Segoe UI"
                                           Foreground="{StaticResource StatusReady}"/>
                            </Border>
                            <Border Padding="16,10"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Visibility="{Binding AdminActionError,
                                                 Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding AdminActionError}"
                                           FontSize="13" FontFamily="Segoe UI"
                                           Foreground="{StaticResource StatusError}"/>
                            </Border>

                            <Border Padding="16,10"
                                    Background="{StaticResource AppBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="USERNAME / EMAIL"
                                               Style="{StaticResource TableHeader}"/>
                                    <TextBlock Grid.Column="1" Text="ROLE"
                                               Style="{StaticResource TableHeader}"/>
                                    <TextBlock Grid.Column="2" Text="ACTIONS"
                                               Style="{StaticResource TableHeader}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FilteredUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Username + Email -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}"
                                                               Style="{StaticResource CardTitleSmall}"/>
                                                    <TextBlock Text="{Binding Email}"
                                                               FontSize="12" FontFamily="Segoe UI"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="4" Padding="8,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Role}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <Button Content="Make Admin"
                                                            Command="{Binding DataContext.PromoteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource InstallButton}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Content="Revoke Admin"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.DemoteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
