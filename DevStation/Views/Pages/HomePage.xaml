<UserControl x:Class="DevStation.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,48">

            <Grid Margin="0,0,0,28">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DevStation" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding UserName, StringFormat='Welcome, {0}!'}"
                               Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13" FontFamily="Segoe UI"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource UserAvatar}">
                        <TextBlock Text="{Binding UserInitials}"
                                   Foreground="{StaticResource LogoIconForeground}"
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatMiniCard}">
                    <StackPanel>
                        <TextBlock Text="// SNIPPETS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SnippetCount}"
                                   FontSize="36" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatMiniCard}">
                    <StackPanel>
                        <TextBlock Text="// AUTHORED" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AuthoredCount}"
                                   FontSize="36" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatMiniCard}">
                    <StackPanel>
                        <TextBlock Text="// FAVORITES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FavoritesCount}"
                                   FontSize="36" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource StatMiniCard}">
                    <StackPanel>
                        <TextBlock Text="// MDN QUERIES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding MdnCount}"
                                   FontSize="36" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
            <WrapPanel Margin="0,0,0,32">
                <Button Content="+ New Snippet" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Command="{Binding CreateSnippetCommand}"/>
                <Button Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="Converter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Convert SVG" FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="ImageOptimizer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Optimize Image" FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"
                        Command="{Binding NavigateCommand}" CommandParameter="MdnSearch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="MDN Search" FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlinedButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="MockGenerator">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mock Data" FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0"
                        Style="{StaticResource ToolCard}" Padding="20,16" ClipToBounds="True">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateCommand}" CommandParameter="Snippets"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource QuickAccessIcon}">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Snippet Library" Style="{StaticResource CardTitleSmall}" Margin="0"/>
                                <TextBlock Text="{Binding SnippetCount, StringFormat='{}{0} snippets in library'}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{StaticResource CodeBackground}" CornerRadius="6" ClipToBounds="True"
                                Visibility="{Binding HasLastSnippet, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource SidebarBackground}"
                                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                                        Padding="14,8">
                                    <TextBlock Text="{Binding LastSnippetTitle}" Style="{StaticResource SectionLabel}"/>
                                </Border>
                                <TextBlock Text="{Binding LastSnippetCodePreview}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextCode}"
                                           Padding="14,10" TextWrapping="Wrap" MaxHeight="64"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Library is empty — create your first snippet"
                                   Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                                   Visibility="{Binding HasLastSnippet, Converter={StaticResource BoolToVisibilityInvertedConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="0"
                        Style="{StaticResource ToolCard}" Padding="20,16">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateCommand}" CommandParameter="Converter"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource QuickAccessIcon}">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SVG Converter" Style="{StaticResource CardTitleSmall}" Margin="0"/>
                                <TextBlock Text="Vector → raster in one click"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="// OUTPUT FORMAT" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock Text="JSX" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextBody}"/>
                            </Border>
                            <Border Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4">
                                <TextBlock Text="React" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextBody}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="2"
                        Style="{StaticResource ToolCard}" Padding="20,16">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateCommand}" CommandParameter="ImageOptimizer"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource QuickAccessIcon}">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Image Optimizer" Style="{StaticResource CardTitleSmall}" Margin="0"/>
                                <TextBlock Text="Lossless image compression"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="// OUTPUT FORMATS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock Text="WebP" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextBody}"/>
                            </Border>
                            <Border Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock Text="JPG" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextBody}"/>
                            </Border>
                            <Border Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4">
                                <TextBlock Text="PNG" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextBody}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="2"
                        Style="{StaticResource ToolCard}" Padding="20,16" ClipToBounds="True">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateCommand}" CommandParameter="MockGenerator"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource QuickAccessIcon}">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Mock Data Generator" Style="{StaticResource CardTitleSmall}" Margin="0"/>
                                <TextBlock Text="JSON mocks for tests and APIs"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{StaticResource CodeBackground}" CornerRadius="6" Padding="14,12">
                            <TextBlock FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextCode}">
                                <Run Text="{}{"/>
                                <LineBreak/>
                                <Run Text="  &quot;id&quot;: " Foreground="{StaticResource TextCodeKeyword}"/>
                                <Run Text="42,"/>
                                <LineBreak/>
                                <Run Text="  &quot;name&quot;: " Foreground="{StaticResource TextCodeKeyword}"/>
                                <Run Text="&quot;Ada Lovelace&quot;" Foreground="{StaticResource TextCodeString}"/>
                                <LineBreak/>
                                <Run Text="}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Recent Snippets" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

            <TextBlock Text="No recent snippets — add a snippet to your library"
                       Style="{StaticResource PageSubtitle}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"
                       Visibility="{Binding HasRecentSnippets, Converter={StaticResource BoolToVisibilityInvertedConverter}}"/>

            <Border Style="{StaticResource CardNoPadding}" ClipToBounds="True"
                    Visibility="{Binding HasRecentSnippets, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding RecentSnippets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{Binding BadgeBrush}"
                                            CornerRadius="4" Padding="8,4" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" MinWidth="22" TextAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeAgo}"
                                               Style="{StaticResource CardId}"
                                               VerticalAlignment="Center" Margin="16,0"/>
                                    <TextBlock Grid.Column="3"
                                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE734;"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="&#xE735;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
