<UserControl x:Class="DevStation.Views.Pages.ImageOptimizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevStation.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <!-- ── Заголовок ── -->
            <TextBlock Text="Image Optimizer" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Lightning-fast compression and format conversion for your web assets."
                       Style="{StaticResource PageSubtitle}"/>

            <!-- ── Drop Zone ── -->
            <!-- Пунктирная граница через Rectangle overlay (WPF не поддерживает напрямую) -->
            <Grid MinHeight="140" Margin="0,16,0,0"
                  Cursor="Hand"
                  AllowDrop="True"
                  MouseLeftButtonUp="DropZone_Click"
                  Drop="DropZone_Drop"
                  DragEnter="DropZone_DragEnter"
                  DragOver="DropZone_DragOver">

                <!-- Фон + пунктирная рамка -->
                <Rectangle Fill="{StaticResource DropZoneBackground}"
                           Stroke="{StaticResource AccentBrush}"
                           StrokeThickness="1.5"
                           StrokeDashArray="6,3"
                           RadiusX="8" RadiusY="8"/>

                <!-- Центрированный контент -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,24">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Drop Assets here or click to browse"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="PNG, JPG, WEBP, SVG • MAX 25MB"
                               FontSize="13" Foreground="{StaticResource TextSecondary}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── Optimization Queue header ── -->
            <Grid Margin="0,24,0,0">
                <TextBlock Text="OPTIMIZATION QUEUE" Style="{StaticResource TableHeader}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Delete all" Style="{StaticResource OutlinedButton}"
                            Command="{Binding DeleteAllCommand}"/>
                    <Button Content="Download" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DownloadAllCommand}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── Table ── -->
            <Border Style="{StaticResource CardNoPadding}" Margin="0,12,0,0">
                <StackPanel>

                    <!-- Table header row -->
                    <Border Padding="16,0"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FILENAME"      Style="{StaticResource TableHeader}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ORIGINAL SIZE" Style="{StaticResource TableHeader}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="OPTIMIZED SIZE" Style="{StaticResource TableHeader}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="STATUS"        Style="{StaticResource TableHeader}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="ACTIONS"       Style="{StaticResource TableHeader}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Data rows -->
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ImageFileItem}">
                                <Border Style="{StaticResource TableRow}" Padding="16,0" MinHeight="56">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- FILENAME: превью + имя + mime -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,8">
                                            <Border Width="40" Height="40" CornerRadius="4"
                                                    Background="#1E1E1E"
                                                    ClipToBounds="True"
                                                    Margin="0,0,12,0">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="20" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityInvertedConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="14" FontFamily="Segoe UI"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding MimeType}"
                                                           FontSize="12" FontFamily="Segoe UI"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ORIGINAL SIZE -->
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalSizeText}"
                                                   FontSize="13" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>

                                        <!-- OPTIMIZED SIZE — три варианта по статусу -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Completed: размер + экономия -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding OptimizedSizeText}"
                                                           FontSize="13" FontFamily="Segoe UI"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text="{Binding SavingsText}"
                                                           FontSize="12" FontFamily="Segoe UI"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Optimizing: рассчитываем -->
                                            <TextBlock Text="(calculating)"
                                                       FontSize="13" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontStyle="Italic"
                                                       Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- Queued: тире -->
                                            <TextBlock Text="—"
                                                       FontSize="13" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- STATUS: текст + прогресс-бар -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <!-- COMPLETED -->
                                            <TextBlock Text="COMPLETED"
                                                       Style="{StaticResource StatusCompleted}"
                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- OPTIMIZING -->
                                            <TextBlock Text="OPTIMIZING"
                                                       Style="{StaticResource StatusCompleted}"
                                                       Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- QUEUED -->
                                            <TextBlock Text="QUEUED"
                                                       Style="{StaticResource StatusQueuedStyle}"
                                                       Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- Прогресс-бар -->
                                            <ProgressBar Style="{StaticResource OptimizationProgress}"
                                                         Value="{Binding Progress}"
                                                         Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- ACTIONS -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- Download (completed) -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    Width="32" Height="32" Padding="0"
                                                    ToolTip="Download"
                                                    Command="{Binding DataContext.DownloadFileCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15" Foreground="{StaticResource TextSecondary}"/>
                                            </Button>
                                            <!-- Cancel (optimizing) -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    Width="32" Height="32" Padding="0"
                                                    ToolTip="Cancel"
                                                    Command="{Binding DataContext.RemoveFileCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                            </Button>
                                            <!-- Delete (queued) -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    Width="32" Height="32" Padding="0"
                                                    ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveFileCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                            </Button>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
