<UserControl x:Class="DevStation.Views.Pages.SvgConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackground}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════ -->
        <!--  LEFT PANEL — Source SVG        -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource CardNoPadding}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Source SVG" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource StatusBadge}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Drop area — переключается между пустым состоянием и кодом -->
                <Grid Grid.Row="1">

                    <!-- Пустое состояние: Drop Zone (клик открывает файловый диалог) -->
                    <Border Style="{StaticResource DropZone}"
                            Margin="12"
                            AllowDrop="True"
                            Cursor="Hand"
                            Drop="DropZone_Drop"
                            DragEnter="DropZone_DragEnter"
                            DragOver="DropZone_DragOver"
                            MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Drop SVG here" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Text="or Select File from directory" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center"
                                       Margin="0,6,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="SVG" Style="{StaticResource BadgeText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Заполненное состояние: SVG-код -->
                    <TextBox Style="{StaticResource CodeInput}"
                             Text="{Binding SvgCode, UpdateSourceTrigger=PropertyChanged}"
                             AllowDrop="True"
                             Drop="DropZone_Drop"
                             DragEnter="DropZone_DragEnter"
                             DragOver="DropZone_DragOver"
                             Margin="0"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityInvertedConverter}}"/>

                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════ -->
        <!--  RIGHT PANEL — JSX Output       -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource CardNoPadding}" Margin="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- JS badge — маленький жёлто-оранжевый прямоугольник -->
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="JS" FontSize="10" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="#1A1A1A"/>
                            </Border>
                            <TextBlock Text="ConvertedComponent.jsx" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Правая часть: JavaScript badge + X -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                                <TextBlock Text="JavaScript" Style="{StaticResource BadgeText}"/>
                            </Border>
                            <Button Style="{StaticResource GhostButton}"
                                    Width="28" Height="28" Padding="0"
                                    Command="{Binding ClearCommand}"
                                    ToolTip="Clear">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Код результата -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource CodeBackground}">
                    <TextBox Style="{StaticResource CodeInput}"
                             Text="{Binding ReactCode, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"/>
                </ScrollViewer>

                <!-- Footer: Copy + Download -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="0,1,0,0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding CopyCommand}"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Copy to clipboard" FontSize="13" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding DownloadCommand}"
                                Margin="8,0,0,0" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Download" FontSize="13" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
