<Window x:Class="DevStation.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DevStation — Auth"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="520"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource DevStationWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TitleBar}"
                MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="DevStation" Style="{StaticResource AuthCaption}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─"
                            Style="{StaticResource WindowMinimizeButton}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="✕"
                            Style="{StaticResource WindowCloseButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Center"
                    Margin="0,32,0,40">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                <Border Style="{StaticResource LogoIconLarge}">
                    <TextBlock Text=">_" Style="{StaticResource LogoIconText}"/>
                </Border>
                <TextBlock Text="DEVSTATION" Style="{StaticResource TerminalHeading}"/>
            </StackPanel>

            <TextBlock Text="SYSTEM AUTHENTITICATION REQUIRED"
                       Style="{StaticResource AuthCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32"/>

            <StackPanel Visibility="{Binding IsLoginMode,
                        Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock Text="IDENTIFIER / USERNAME" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DefaultInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="SECURITY TOKEN / PASSWORD"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="LOST TOKEN?"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ForgotPasswordCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
                <PasswordBox x:Name="loginPasswordBox"
                             Style="{StaticResource DefaultPasswordBox}"
                             PasswordChanged="LoginPasswordBox_PasswordChanged"
                             Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource AuthError}"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,8"/>

                <Button Content="EXECUTE AUTHENTICATION  >"
                        Style="{StaticResource AuthExecuteButton}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"/>

                <Rectangle Style="{StaticResource Divider}" Margin="0,28,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="NEW INSTANCE?  "
                               Style="{StaticResource AuthCaption}"
                               VerticalAlignment="Center"/>
                    <Button Content="SWITCH TO REGISTER"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding SwitchToRegisterCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsLoginMode,
                        Converter={StaticResource BoolToVisibilityInvertedConverter}}">

                <TextBlock Text="IDENTIFIER / USERNAME" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DefaultInput}"
                         Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DefaultInput}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="SECURITY TOKEN / PASSWORD" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="registerPasswordBox"
                             Style="{StaticResource DefaultPasswordBox}"
                             PasswordChanged="RegisterPasswordBox_PasswordChanged"
                             Margin="0,0,0,16"/>

                <TextBlock Text="CONFIRM TOKEN" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="confirmPasswordBox"
                             Style="{StaticResource DefaultPasswordBox}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource AuthError}"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,8"/>

                <Button Content="CREATE NEW INSTANCE  >"
                        Style="{StaticResource AuthExecuteButton}"
                        Command="{Binding RegisterCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"/>

                <Rectangle Style="{StaticResource Divider}" Margin="0,28,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ALREADY REGISTERED?  "
                               Style="{StaticResource AuthCaption}"
                               VerticalAlignment="Center"/>
                    <Button Content="SWITCH TO LOGIN"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding SwitchToLoginCommand}"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
