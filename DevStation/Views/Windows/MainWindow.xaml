<Window x:Class="DevStation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevStation.ViewModels"
        xmlns:pages="clr-namespace:DevStation.Views.Pages"
        mc:Ignorable="d"
        Title="DevStation"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DevStationWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <!-- DataTemplates: добавлять по одному при создании каждой страницы -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <pages:HomePage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConverterViewModel}">
            <pages:SvgConverterPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ImageOptimizerViewModel}">
            <pages:ImageOptimizerPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MockGeneratorViewModel}">
            <pages:MockDataPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SnippetsViewModel}">
            <pages:SnippetsPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SnippetDetailViewModel}">
            <pages:SnippetDetailPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CreateSnippetViewModel}">
            <pages:CreateSnippetPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MdnSearchViewModel}">
            <pages:MdnSearchPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <pages:AccountPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DocumentationViewModel}">
            <pages:DocumentationPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!--  SIDEBAR                                -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource SidebarContainer}">
            <DockPanel>

                <!-- Логотип (кликабельная область для перетаскивания окна) -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="16,20,16,24"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Cursor="SizeAll">
                    <Border Style="{StaticResource LogoIcon}">
                        <TextBlock Style="{StaticResource LogoIconText}" Text=">_"/>
                    </Border>
                    <TextBlock Text="DevStation" Style="{StaticResource LogoText}"/>
                </StackPanel>

                <!-- Нижние пункты: Account, Documentation, Logout -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Rectangle Style="{StaticResource Divider}" Margin="16,0,16,8"/>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Account">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Account">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Account" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Documentation">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Documentation">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Documentation" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarItem}" Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Logout" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Основная навигация -->
                <StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Home">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Converter">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Converter">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Converter" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="MdnSearch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="MdnSearch">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="MDN Search" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="ImageOptimizer">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="ImageOptimizer">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Image Optimizer" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="MockGenerator">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="MockGenerator">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Mock Generator" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Snippets">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Snippets">
                                        <Setter Property="Tag" Value="active"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Snippets" FontSize="13" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--  CONTENT AREA                           -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TopBar (Row 0) — поиск, иконки приложения, управление окном -->
            <!-- Правый padding = 0, чтобы кнопки управления окном шли вплотную к краю -->
            <Border Grid.Row="0"
                    Style="{StaticResource TopBarContainer}"
                    Padding="16,0,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">

                    <!-- Кнопки управления окном (крайние справа, без padding) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource WindowMinimizeButton}" Click="MinimizeButton_Click"
                                ToolTip="Свернуть">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WindowMaximizeButton}" Click="MaximizeButton_Click"
                                ToolTip="Развернуть">
                            <TextBlock x:Name="MaxRestoreIcon" Text="&#xE922;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"
                                ToolTip="Закрыть">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>

                    <!-- Иконки приложения: уведомления, настройки, профиль -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Rectangle Width="1" Fill="{StaticResource BorderSubtle}"
                                   VerticalAlignment="Stretch" Margin="0,12,8,12"/>
                        <Button Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                                Command="{Binding NavigateCommand}" CommandParameter="Account">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Поле поиска с иконкой, хоткеем ALT·SPACE и выпадающим списком -->
                    <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Width="320">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchInput}"
                                 Padding="36,0,96,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_KeyDown"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="10,0" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsSearchOpen,
                                                 Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                            <Border Style="{StaticResource HotkeyBadge}">
                                <TextBlock Text="ALT" FontSize="10" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <TextBlock Text="·" Foreground="{StaticResource TextMuted}"
                                       Margin="4,0" VerticalAlignment="Center" FontSize="11"/>
                            <Border Style="{StaticResource HotkeyBadge}">
                                <TextBlock Text="SPACE" FontSize="10" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>

                        <!-- Dropdown результатов ($query / ?query) -->
                        <Popup x:Name="SearchPopup"
                               IsOpen="{Binding IsAnySearchOpen, Mode=OneWay}"
                               PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom"
                               StaysOpen="True"
                               Width="320"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                <StackPanel>

                                    <!-- ── Snippets section ($) ── -->
                                    <StackPanel Visibility="{Binding HasDollarQuery,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="SNIPPETS" Style="{StaticResource TableHeader}"
                                                   Margin="4,4,4,8"/>
                                        <ItemsControl x:Name="SearchItemsControl"
                                                      ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                                                    <Border Padding="8,7" CornerRadius="4" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.UseResultCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource BorderDefault}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="›"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="14" FontFamily="Segoe UI"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Visibility="{Binding IsSelected,
                                                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding UserSnippet.Snippet.Title}"
                                                                           FontSize="13" FontFamily="Segoe UI"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding UserSnippet.Snippet.Language}"
                                                                       Style="{StaticResource CardId}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No snippets found."
                                                   Style="{StaticResource CardId}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,4"
                                                   Visibility="{Binding HasNoResults,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="↑↓ navigate · Enter copy · Esc close"
                                                   Style="{StaticResource CardId}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,2"/>
                                    </StackPanel>

                                    <!-- ── MDN Docs section (?) ── -->
                                    <StackPanel Visibility="{Binding HasQuestionQuery,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="// MDN DOCS" Style="{StaticResource TableHeader}"
                                                   Margin="4,4,4,8"/>

                                        <!-- Loading indicator -->
                                        <TextBlock Text="Searching docs…"
                                                   Style="{StaticResource CardId}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,4"
                                                   Visibility="{Binding IsMdnLoading,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Results -->
                                        <ItemsControl ItemsSource="{Binding MdnResults}"
                                                      Visibility="{Binding IsMdnSearchOpen,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,8" CornerRadius="4"
                                                            Margin="0,1" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.OpenMdnResultCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource BorderDefault}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="›"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="14" FontFamily="Segoe UI"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0"
                                                                               Visibility="{Binding IsSelected,
                                                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="13" FontFamily="Segoe UI"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimary}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Right"
                                                                        Background="{StaticResource AccentMutedBrush}"
                                                                        CornerRadius="3" Padding="5,2">
                                                                    <TextBlock Text="{Binding Category}"
                                                                               FontSize="10" FontFamily="Segoe UI"
                                                                               Foreground="{StaticResource AccentBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Summary}"
                                                                       FontSize="11" FontFamily="Segoe UI"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxHeight="28"
                                                                       Margin="0,3,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- No results -->
                                        <TextBlock Text="No documentation found."
                                                   Style="{StaticResource CardId}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,4"
                                                   Visibility="{Binding HasNoMdnResults,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <TextBlock Text="↑↓ navigate · Enter open · Esc close"
                                                   Style="{StaticResource CardId}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,2"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- Контентная область (Row 1) — ContentControl отображает текущую страницу -->
            <!-- Для добавления новой страницы: добавить DataTemplate в Window.Resources -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Background="{StaticResource AppBackground}"/>

        </Grid>
    </Grid>
</Window>
