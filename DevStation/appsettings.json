    "SearchResultsLimit": 8,
    "MdnSearchLimit": 5,
    "DebounceDelayMs": 400,
    "MaxFileSizeBytes": 26214400,
    "JpegQuality": 82,
    "WebpQuality": 85,
    "HttpTimeoutSeconds": 10
  }
}
